# Copia este archivo como .env.local y rellena los valores

# Configuración SMTP para el formulario de contacto
# Gmail: activa "Contraseñas de aplicación" en tu cuenta de Google
# (Requiere 2FA activada: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx   # App Password de Gmail (16 caracteres)

# Email donde se recibirán los mensajes del formulario
EMAIL_TO=vectorsur@gmail.com
